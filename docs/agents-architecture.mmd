    linkStyle 18 stroke:#1b5e20,stroke-width:3px
    linkStyle 19 stroke:#1b5e20,stroke-width:3px
    linkStyle 20 stroke:#1b5e20,stroke-width:3px
    linkStyle 21 stroke:#303f9f,stroke-width:3px
    linkStyle 22 stroke:#303f9f,stroke-width:3px
    linkStyle 23 stroke:#ff6f00,stroke-width:3px
    linkStyle 24 stroke:#01579b,stroke-width:3px
    linkStyle 25 stroke:#01579b,stroke-width:3px
